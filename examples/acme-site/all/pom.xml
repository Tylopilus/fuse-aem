<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.acme</groupId><artifactId>acme-site</artifactId><version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>acme-site.all</artifactId>
    <packaging>content-package</packaging>
    <dependencies>
        <dependency>
            <groupId>com.acme</groupId><artifactId>acme-site.core</artifactId><version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.acme</groupId><artifactId>acme-site.ui.apps</artifactId><version>${project.version}</version><type>zip</type>
        </dependency>
        <dependency>
            <groupId>dev.fuse.aem</groupId><artifactId>fuse-runtime</artifactId><version>0.1.0-SNAPSHOT</version>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.jackrabbit</groupId><artifactId>filevault-package-maven-plugin</artifactId>
                <configuration>
                    <packageType>container</packageType>
                    <embeddeds>
                        <embedded>
                            <groupId>com.acme</groupId><artifactId>acme-site.core</artifactId>
                            <target>/apps/acme-packages/application/install</target>
                        </embedded>
                        <embedded>
                            <groupId>com.acme</groupId><artifactId>acme-site.ui.apps</artifactId><type>zip</type>
                            <target>/apps/acme-packages/application/install</target>
                        </embedded>
                        <embedded>
                            <groupId>dev.fuse.aem</groupId><artifactId>fuse-runtime</artifactId>
                            <target>/apps/acme-packages/application/install</target>
                        </embedded>
                    </embeddeds>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
