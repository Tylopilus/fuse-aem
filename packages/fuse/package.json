{
  "name": "@fuse-aem/fuse",
  "version": "0.1.0",
  "description": "Qwik-style single-file components for AEM as a Cloud Service, compiled to native HTL, dialogs, Sling Models and clientlibs.",
  "type": "module",
  "bin": { "fuse": "./bin/fuse.js" },
  "exports": {
    ".": { "types": "./src/core/index.ts", "default": "./dist/core/index.js" },
    "./jsx-runtime": { "types": "./src/core/jsx-runtime.ts", "default": "./dist/core/jsx-runtime.js" },
    "./jsx-dev-runtime": { "types": "./src/core/jsx-runtime.ts", "default": "./dist/core/jsx-runtime.js" },
    "./compiler": { "types": "./src/compiler/index.ts", "default": "./dist/compiler/index.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@adobe/htlengine": "^6.4.48",
    "chokidar": "^3.6.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.19.0"
  },
  "engines": { "node": ">=18" }
}
